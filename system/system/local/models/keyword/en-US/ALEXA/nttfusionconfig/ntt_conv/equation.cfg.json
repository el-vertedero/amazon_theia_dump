{
    "config_type": "ntt_fusion_equation",
    "config_version": 1,
    "enable_verbose_logging": false,
    "score_span_tracker": {
        "start_lockout_msec": 0,
        "max_history_msec": 1600
    },
    "equation": [
        "(",
            "DVAD_NO_PB",
            "OR",
            "DVAD_PB", "AND", "UED", "AND", "NO_TTS",
            "OR",
            "DVAD_PB_LOW", "AND", "SCD", "AND", "UED", "AND", "NO_TTS",
        ")",
        "AND", "WAIT_FOR_SID", "AND", "NO_LOCKOUT"
    ],
    "algorithms": [
        {
            "name": "DVAD_SOS",
            "algo_type": "dvad",
            "result_type": "binary",
            "config_file_path": "dvad_sos.cfg.json",
            "metadata_key": "ntt_dvad"
        },
        {
            "name": "DVAD_NO_PB",
            "algo_type": "dvad",
            "result_type": "binary",
            "config_file_path": "dvad_no_pb.cfg.json"
        },
        {
            "name": "DVAD_PB",
            "algo_type": "dvad",
            "result_type": "binary",
            "config_file_path": "dvad_pb.cfg.json",
            "collect_reject_metric": true
        },
        {
            "name": "DVAD_PB_LOW",
            "algo_type": "dvad",
            "result_type": "binary",
            "config_file_path": "dvad_pb_low.cfg.json",
            "collect_reject_metric": true
        },
        {
            "name": "NO_LOCKOUT",
            "algo_type": "lockout",
            "result_type": "binary",
            "config_file_path": "lockout.cfg.json"
        },
        {
            "name": "UED",
            "algo_type": "afe",
            "result_type": "binary",
            "config_file_path": "afe_ued.cfg.json",
            "collect_reject_metric": true
        },
        {
            "name": "NO_TTS",
            "algo_type": "sid",
            "result_type": "binary",
            "config_file_path": "no_tts.cfg.json",
            "metadata_key": "ntt_sid_tts"
        },
        {
            "name": "SCD",
            "algo_type": "sid",
            "result_type": "binary",
            "config_file_path": "scd.cfg.json",
            "metadata_key": "ntt_sid_scd",
            "collect_reject_metric": true
        },
        {
            "name": "WAIT_FOR_SID",
            "algo_type": "sid",
            "result_type": "binary",
            "config_file_path": "wait_for_sid.cfg.json"
        }
    ],
    "span_provider": "DVAD_SOS",
    "accept_lockout_msec": 1200
}

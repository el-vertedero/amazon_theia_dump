{
  "acoustic-model": {
    "non-speech-pdf": 0,
    "speech-pdf": 0
  },
  "keyword-orchestra": {
    "buffer-size": 200,
    "keyword-spotters": [
      {
        "classifier": {
          "decay-rate": 0.6,
          "type": "exponential-decay"
        },
        "name": "ALEXA",
        "spotter": {
          "classification-thresholds": {
            "accept-threshold": 0.6,
            "notify-threshold": 0.6
          },
          "keyword-feature-window-length": 100,
          "lock-period": 100,
          "word-component-array": [
            {
              "keyword-end-scorer-index": 1,
              "keyword-start-end-component": {
                "name": "dense",
                "posterior-type": "time-alignment-scores"
              },
              "keyword-start-scorer-index": 0,
              "scorer-index": 1,
              "scorer-output-component": {
                "name": "post",
                "posterior-type": "decoding-scores"
              }
            }
          ]
        }
      },
      {
        "classifier": {
          "decay-rate": 0.3,
          "type": "exponential-decay"
        },
        "name": "STOP",
        "spotter": {
          "classification-thresholds": {
            "accept-threshold": 1e+37,
            "notify-threshold": 1e+37
          },
          "is-local-command": false,
          "keyword-feature-window-length": 100,
          "lock-period": 100,
          "word-component-array": [
            {
              "keyword-end-scorer-index": 1,
              "keyword-start-end-component": {
                "name": "dense",
                "posterior-type": "time-alignment-scores"
              },
              "keyword-start-scorer-index": 0,
              "scorer-index": 2,
              "scorer-output-component": {
                "name": "post",
                "posterior-type": "decoding-scores"
              }
            }
          ]
        }
      }
    ]
  },
  "keyword-orchestra-monitor": {
    "statistics": {
      "classification": {
        "histogram": {
          "max": 1,
          "min": 0,
          "size": 50
        }
      },
      "segmentation": {
        "histogram": {
          "max": 1,
          "min": 0,
          "size": 1
        }
      }
    }
  },
  "object_type_name": "keyword-spotter-orchestra-config",
  "object_type_version": 2,
  "word-symbol-table": {
    "filename": "words.shrunk.txt"
  }
}
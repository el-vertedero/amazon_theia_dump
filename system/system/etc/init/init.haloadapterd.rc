# FOS haloadapterd init.rc configuration

on post-fs-data
    mkdir /data/securedStorageLocation/SmartHome 0777 smarthome smarthome

on property:sys.boot_completed=1
    chmod 777 /data/securedStorageLocation/SmartHome/PROT_HALO/CapabilityInstanceDatabase.db
    chmod 777 /data/securedStorageLocation/SmartHome/PROT_HALO/HaloAdapterDatabase.db
    chmod 777 /data/securedStorageLocation/SmartHome/PROT_HALO/HaloAdapterDatabase.db-journal
    start haloadapterd

service haloadapterd /system/bin/SmartHomeHalod
    class main
    user smarthome
    group dbus inet
    disabled
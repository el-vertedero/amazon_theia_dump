on post-fs-data
    mkdir /data/minerva 0751 system system
    mkdir /data/minerva/metrics 0751 system system

on property:kvs_init_completed=1
    start minerva_service

service minerva_service /system/bin/minerva_service
    class main
    user system
    group system dbus aipc ace_group ace_kvstore inet ace_maplite
    disabled

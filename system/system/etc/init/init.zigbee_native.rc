service zigbeeservice /system/bin/ace_zigbee_service
    setenv SHMLIB_DISABLE_ONLOAD true
    class main
    user vendor_zigbee
    group system vendor_zigbee vendor_aipc vendor_ace_kv_storage vendor_ace_group
    onrestart restart zigbee-2-0

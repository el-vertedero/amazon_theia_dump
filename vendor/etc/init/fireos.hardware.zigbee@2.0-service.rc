# ZigbeeHIDL uses group net_admin because ZigbeeHIDL accesses
# zigbeeHAL API which in turn writes to /sys/class/rfkill nodes.
# The rfkill kernel driver checks for capability CAP_NET_ADMIN
# and only processes possessing CAP_NET_ADMIN can write to rfkill.
# Otherwise return with errno "Operation not permitted". Group net_admin
# makes ZigbeeHIDL inherit CAP_NET_ADMIN
service zigbee-2-0 /vendor/bin/hw/fireos.hardware.zigbee@2.0-service
    class hal
    user system
    group system net_admin
    onrestart restart zigbeeservice
    disabled

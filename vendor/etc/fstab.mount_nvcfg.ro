# Android fstab file.
#<src>                                           <mnt_point>      <type> <mnt_flags and options>                           <fs_mgr_flags>
/dev/block/platform/bootdevice/by-name/nvcfg     /mnt/vendor/nvcfg  ext4 ro,noatime,nosuid,nodev,noauto_da_alloc,discard   wait,check,formattable,notrim
